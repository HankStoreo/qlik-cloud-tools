#!/bin/sh
# Secret scan on staged changes, if gitleaks is installed; CI scans every push regardless.
local_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$local_hook" ]; then "$local_hook" "$@" || exit 1; fi
if command -v gitleaks >/dev/null 2>&1; then exec gitleaks git --staged --no-banner --redact; fi
